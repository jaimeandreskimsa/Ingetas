# ------------------------------------------------------------------
# Ingetas 2026 — Variables de entorno
# ------------------------------------------------------------------
# DATABASE_URL va en el archivo ".env" (lo lee Prisma). El resto en ".env.local".
# ------------------------------------------------------------------

# --- .env (Prisma) ---
# Local con Docker (ver README) o el DATABASE_URL de Railway en producción.
DATABASE_URL="postgresql://ingetas:ingetas@localhost:5544/ingetas?schema=public"

# --- .env.local (Next.js) ---
NEXTAUTH_URL=http://localhost:3000
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=

# Credenciales OAuth de Google (para conectar la cuenta principal de Drive).
# Redirección autorizada: <NEXTAUTH_URL>/api/drive/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (Opcional) Envío del formulario de contacto por Resend
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=ingetas@vtr.net
